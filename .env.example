# ── 로컬 인프라 (docker compose) ─────────────────────────────────────────
# cp .env.example .env 후 필요한 값만 바꾸세요. 그대로 써도 동작합니다.

# PostgreSQL 17 + pgvector  →  postgresql://kg:kg@localhost:5432/kg
POSTGRES_USER=kg
POSTGRES_PASSWORD=kg
POSTGRES_DB=kg
POSTGRES_PORT=5432

# Elasticsearch 9 + nori    →  http://localhost:9200 (인증 없음)
ES_VERSION=9.1.0
ES_PORT=9200
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Kibana (선택, --profile ui) →  http://localhost:5601
KIBANA_PORT=5601

# Neo4j 5.26 LTS + APOC     →  bolt://localhost:7687 / http://localhost:7474
# 비밀번호는 8자 이상이어야 합니다.
NEO4J_VERSION=5.26-community
NEO4J_PASSWORD=kgstudy2026
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PLUGINS=["apoc"]

# ── 실습/현황판에서 쓰는 키 (선택) ───────────────────────────────────────
# OPENAI_API_KEY=sk-...
