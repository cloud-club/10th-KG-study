ES_URL=http://localhost:9200
# Elasticsearch 접속 주소. docker compose로 로컬에 띄운 ES의 REST API 엔드포인트

POSTGRES_DSN=postgresql://study:study@localhost:5432/chat_search
# pgvector가 설치된 PostgreSQL 접속 문자열 (사용자:비밀번호@호스트:포트/DB이름)

OLLAMA_URL=http://localhost:11434
# 임베딩 생성에 쓰는 로컬 Ollama 서버 주소

EMBEDDING_MODEL=bge-m3
# Ollama에서 pull 받아 pgvector 색인에 쓸 임베딩 모델 이름 (Mediary 때 쓴 것과 동일)