# W2 실습의 DB/ES/임베딩 설정을 먼저 읽고, 이 파일의 값으로 덮어씁니다.
INGEST_ROOT=../01-ingest

# ---- 하이브리드 검색 ----
RRF_RANK_CONSTANT=60
RRF_CANDIDATE_K=50
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000
HNSW_EF_SEARCH=100

# W2와 같은 임베딩 모델이어야 합니다.
EMBED_PROVIDER=local
EMBED_MODEL=nlpai-lab/KURE-v1
EMBED_DIM=1024

# 질문에 실명이 들어오면 이 로컬 매핑표로 먼저 가명화합니다.
# NAME_MAP_PATH=../01-ingest/data/private/name_map.json

# ---- 답변 생성 ----
# none: 검색·평가만 수행. 개인 카톡에는 이 값이 안전한 기본값입니다.
LLM_PROVIDER=none
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=800

# OpenAI API
# LLM_PROVIDER=openai
# LLM_MODEL=<사용할 소형 모델>
# OPENAI_API_KEY=...

# Gemini API
# LLM_PROVIDER=gemini
# LLM_MODEL=<사용할 소형 모델>
# GEMINI_API_KEY=...

# Ollama 로컬 모델 (권장: 데이터가 노트북 밖으로 나가지 않음)
#   brew install ollama && brew services start ollama
#   ollama pull exaone3.5:7.8b
#   ollama create kakao-rag -f ollama/Modelfile.exaone   # num_ctx 8192 — 기본 4096이면 근거가 잘릴 수 있음
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=kakao-rag
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama            # 로컬 서버는 값을 무시하지만 필드는 필요
