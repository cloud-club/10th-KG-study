# 복사해서 .env 로 저장 (.env 는 .gitignore 에 있음)
DATABASE_URL=postgresql://kg:kg@localhost:5432/kg
ES_URL=http://localhost:9200
ES_INDEX=kakao_chunks
ES_MSG_INDEX=kakao_messages

# ---- 임베딩 제공자: 셋 중 하나만 살려서 쓴다 ----
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
OPENAI_API_KEY=sk-...

# EMBED_PROVIDER=gemini
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768            # 3072/1536/768 중 선택(MRL). 768이면 저장 공간 1/4
# GEMINI_API_KEY=...

# EMBED_PROVIDER=local
# EMBED_MODEL=nlpai-lab/KURE-v1     # 또는 BAAI/bge-m3 (둘 다 1024차원, API 키 불필요, 첫 실행 시 ~2GB 다운로드)
# EMBED_DIM=1024

EMBED_BATCH=64

# ---- 청킹 ----
SESSION_GAP_MIN=30
CHUNK_MAX_MSGS=30
CHUNK_MAX_CHARS=700
CHUNK_OVERLAP_MSGS=3
